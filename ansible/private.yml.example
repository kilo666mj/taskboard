taskboard_auth_token: replace-with-at-least-32-random-characters
taskboard_database_url: ""
taskboard_vapid_public_key: replace-me
taskboard_vapid_private_key: replace-me
taskboard_vapid_contact: mailto:admin@example.com
taskboard_allowed_hosts:
  - taskboard.example.com
taskboard_oidc_issuer: https://idp.example.com
taskboard_oidc_client_id: taskboard
taskboard_oidc_client_secret: ""
taskboard_oidc_redirect_url: https://taskboard.example.com/api/v1/auth/oidc/callback
taskboard_oidc_allowed_subjects: []
taskboard_oidc_allowed_emails:
  - user@example.com
taskboard_oidc_allowed_groups: []
taskboard_oidc_trust_provider_policy: false
taskboard_default_role: member
# personal or work fixes every task's type and hides the type selector.
taskboard_task_type: ""
taskboard_owner_groups: []
taskboard_admin_groups: []
taskboard_member_groups: []
taskboard_viewer_groups: []
taskboard_agent_policies_json: ""
taskboard_webhook_secret: ""
taskboard_browser_auth_mode: oidc
taskboard_cf_access_team_domain: ""
taskboard_cf_access_aud: ""
taskboard_cf_access_allowed_subjects: []
taskboard_cf_access_allowed_emails: []
taskboard_cf_access_allowed_groups: []
taskboard_cf_access_trust_policy: false
taskboard_mcp_human_delegation: false
# Dedicated agent credential principals, such as agent:switchboard, allowed to
# forward a Cloudflare Access person in X-Switchboard-Access-Subject.
taskboard_mcp_delegation_principals: []
