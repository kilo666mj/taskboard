TASKBOARD_LISTEN_ADDRESS=0.0.0.0:8095
TASKBOARD_DATABASE_PATH=/var/lib/taskboard/taskboard.db
# Set this to use PostgreSQL instead of TASKBOARD_DATABASE_PATH.
TASKBOARD_DATABASE_URL=
TASKBOARD_AUTH_TOKEN=replace-with-at-least-32-random-characters
TASKBOARD_ALLOWED_HOSTS=taskboard.example.com
TASKBOARD_LEASE_SECONDS=120
TASKBOARD_MCP_DEFAULT_TYPE=work
TASKBOARD_BROWSER_AUTH_MODE=oidc
TASKBOARD_VAPID_PUBLIC_KEY=
TASKBOARD_VAPID_PRIVATE_KEY=
TASKBOARD_VAPID_CONTACT=mailto:admin@example.com
TASKBOARD_OIDC_ISSUER=https://idp.example.com
TASKBOARD_OIDC_CLIENT_ID=taskboard
TASKBOARD_OIDC_CLIENT_SECRET=
TASKBOARD_OIDC_REDIRECT_URL=https://taskboard.example.com/api/v1/auth/oidc/callback
TASKBOARD_OIDC_ALLOWED_SUBJECTS=
TASKBOARD_OIDC_ALLOWED_EMAILS=
TASKBOARD_OIDC_ALLOWED_GROUPS=
# Alternative browser and agent authentication through Cloudflare Access:
# TASKBOARD_BROWSER_AUTH_MODE=cloudflare_access
# TASKBOARD_CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# TASKBOARD_CF_ACCESS_AUD=replace-with-the-access-application-aud-tag
# TASKBOARD_CF_ACCESS_ALLOWED_SUBJECTS=
# TASKBOARD_CF_ACCESS_ALLOWED_EMAILS=
# TASKBOARD_CF_ACCESS_ALLOWED_GROUPS=
