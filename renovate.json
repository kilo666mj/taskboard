{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "enabledManagers": [
    "cargo",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Group low-risk Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Go module updates"
    },
    {
      "description": "Group low-risk Rust crate updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Rust crate updates"
    },
    {
      "description": "Keep Go and Rust major updates separate",
      "matchManagers": ["gomod", "cargo"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Keep Go Docker base image updates separate",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "groupName": "Go Docker base image"
    }
  ]
}
