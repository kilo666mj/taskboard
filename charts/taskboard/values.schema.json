{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "urlKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "urlKey": { "type": "string", "minLength": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "authTokenKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "authTokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "taskboard": {
      "type": "object",
      "properties": {
        "browserAuthMode": { "enum": ["oidc", "cloudflare_access"] },
        "leaseSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "mcpDefaultType": { "enum": ["personal", "work"] },
        "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "roles": {
          "type": "object",
          "required": ["default", "ownerGroups", "adminGroups", "memberGroups", "viewerGroups"],
          "properties": {
            "default": { "enum": ["owner", "admin", "member", "viewer"] },
            "ownerGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "adminGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "memberGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "viewerGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  },
  "required": ["replicaCount", "image", "database", "secrets", "taskboard"]
}
